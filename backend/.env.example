# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change-this-secret-key-in-production

# Database Connection (Optional for local dev - defaults to SQLite employees.db if omitted)
# For Render PostgreSQL: postgresql://username:password@hostname:5432/databasename
DATABASE_URL=

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
